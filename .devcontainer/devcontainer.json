{
  "name": "ROS Noetic Dev Container",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "runArgs": [
    "--gpus=all",
    "--privileged",
    "--network=host",
    "-e", "DISPLAY=${localEnv:DISPLAY}",
    "--shm-size=16g"
  ],
  "mounts": [
    "source=/etc/localtime,target=/etc/localtime:ro,type=bind,consistency=cached",
    "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind"
  ],
  "postAttachCommand": "sudo sysctl -w net.core.rmem_max=2147483647 && sudo sysctl -w net.core.rmem_default=2147483647",
  "settings": {
    "terminal.integrated.defaultProfile.linux": "bash"
  },
  "remoteUser": "root"
}
